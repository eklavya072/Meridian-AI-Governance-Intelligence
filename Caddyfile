# Meridian reverse proxy — used by docker-compose.prod.yml
# SITE_ADDRESS comes from .env.prod via compose environment substitution.
{$SITE_ADDRESS:localhost} {
    # There is no user auth in the application, and every analysis spends the
    # operator's model quota. Until a site is meant to be public, uncomment
    # this and set a user and a bcrypt hash (`caddy hash-password`):
    #
    # basic_auth {
    #     {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    # }

    # The API may run as more than one container during a rollout
    # (deploy/rollout.sh). `api` is resolved on every connection, so both
    # containers are candidates while both exist; a container that refuses
    # (still starting, or draining) is skipped for the other, and retrying for
    # a few seconds covers the moment the old one is removed.
    @api path /api/* /healthz /readyz
    handle @api {
        reverse_proxy api:8000 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }
    handle {
        reverse_proxy web:3000
    }
}
