# ── Environment & secrets (never commit) ────────────────────────────────
.env
.env.local
.env.prod
.env.*.local

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / Next.js ──────────────────────────────────────────────────────
node_modules/
.next/
.next-dev/
out/
npm-debug.log*
*.tsbuildinfo

# ── ChromaDB persistence (indexed corpus — shipped separately, never git) ─
**/chroma/

# ── Raw framework PDFs (large, sourced locally — shipped separately) ────
**/raw_policies/*.pdf
!**/raw_policies/.gitkeep

# ── Uploaded documents & generated output (private user data) ───────────
backend/data/uploads/
backend/data/reports/
backend/data/gemini_rpd.json
backend/data/provider_health.json

# ── IDE / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ── Logs ────────────────────────────────────────────────────────────────
*.log

# ── Chroma incident backups (kept on disk for forensics, never git) ─────
backend/data/chroma_broken_*/
backend/data/chroma_hnsw_corrupt_*/

# ── Stray local SQLite (the app uses Postgres) ──────────────────────────
backend/data/*.db

# ── Coverage output ────────────────────────────────────────────────────
.coverage
coverage.xml
htmlcov/

# ── Editor backups ─────────────────────────────────────────────────────
*.bak

# ── Frontend public assets ──────────────────────────────────────────────
# Only the hero film and its poster are tracked; local PDFs and alternative
# footage stay out of commits, build contexts and image layers.
frontend/public/*.pdf
frontend/public/hero/*
!frontend/public/hero/hero-scrub.mp4
!frontend/public/hero/hero-poster.jpg

# Local editor/assistant config
CLAUDE.md
**/.claude/

# ── Private working material (not for the public repository) ──────────
# The session handoff, the unpublished working paper and the engineering
# notes that carry its benchmark results, and the benchmark data itself.
handoff.md
paper/
docs/ENGINEERING-NOTES.md
backend/data/benchmarks/

# Local design-tool state (impeccable critique snapshots)
.impeccable/
