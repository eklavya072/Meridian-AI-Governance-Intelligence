# Database
DATABASE_URL=postgresql+asyncpg://aura:aura@localhost:5432/aura_sdg

# LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
# Additional keys for rotation: GEMINI_API_KEY_2, GEMINI_API_KEY_3, ...
# The analysis pool round-robins across ALL configured keys (per-key RPM
# throttle), so more keys = faster analyses without exceeding any key's
# free-tier ceiling.
# GEMINI_API_KEY_2=your-second-gemini-key

# Groq (used when LLM_PROVIDER=groq, or as fallback when Gemini keys exhaust)
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (alternative primary provider)
# CEREBRAS_API_KEY=your-cerebras-key

# Application
LOG_LEVEL=INFO
DEV_MODE=false
CHROMA_PERSIST_DIR=./data/chroma
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF=2.0

# Comma-separated browser origins allowed by CORS (frontend domains)
# CORS_ORIGINS=https://meridian.example.com,http://localhost:3000

# Parallel dimension-analysis workers (default 8). Each dimension is one
# combined evaluation+recommendations LLM call; with multiple Gemini keys the
# pool round-robins across keys (per-key RPM throttle), so higher is faster
# up to the key count x per-key RPM ceiling.
# ANALYSIS_MAX_CONCURRENCY=8

# Gemini free-tier throttle, PER KEY (each configured GEMINI_API_KEY_N gets
# its own window): flash-tier models allow ~10-15 requests/min per key.
# GEMINI_RPM_LIMIT=10

# Chat reply budget (tokens). Chat prompts cap replies at ~120 words, so the
# analysis path's 8192-token generation budget is overkill here and adds
# latency; a smaller cap makes chat replies complete faster.
# CHAT_MAX_OUTPUT_TOKENS=2048

# Deterministic coverage ladder (backend/src/deterministic.py)
# 1 = R1 floor active: Missing is raised to Partial only on an explicit
#     commitment/attempted mechanism (never a bare risk acknowledgment).
# 0 = R1 floor disabled: Missing stays Missing (R2 can only raise Partial to
#     Covered). Used for before/after comparisons of floor impact.
LADDER_FLOOR_ENABLED=1

[PRODUCTION]
# Used by docker-compose.prod.yml — see LAUNCH.md
# Public API URL inlined into the frontend at build time:
# NEXT_PUBLIC_API_URL=https://meridian.example.com/api/v1
# Public domain for Caddy TLS:
# SITE_ADDRESS=meridian.example.com
