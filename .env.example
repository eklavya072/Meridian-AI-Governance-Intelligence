# Database
DATABASE_URL=postgresql+asyncpg://aura:aura@localhost:5432/aura_sdg

# LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
#
# One key is the supported configuration.
#
# The router accepts GEMINI_API_KEY_2..9 and will round-robin across them,
# because a deployment can legitimately hold several credentials — separate
# billing projects for separate environments, or a rotation window where an
# old and a new key are both live. Use it for that.
#
# Do NOT add keys from additional accounts to raise free-tier throughput.
# Google APIs Terms of Service section 2(d): "Google sets and enforces
# limits on your use of the APIs [...] You agree to, and will not attempt
# to circumvent, such limitations documented with each API." Free-tier RPM
# and RPD are per project. Multiplying them across accounts is exactly the
# circumvention that clause names, and keys under one billing account
# inherit that account's tier anyway, so it does not even work.
#
# The quota accounting, per-key throttling, failover and backoff in
# provider_router.py are worth having with a single key — they are what
# stops one document exhausting a budget and what makes an exhausted
# budget fail with a clear message instead of a half-finished brief.
# GEMINI_API_KEY_2=second-key-for-rotation-or-a-separate-project

# Groq (used when LLM_PROVIDER=groq, or as fallback when Gemini keys exhaust)
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (alternative primary provider)
# CEREBRAS_API_KEY=your-cerebras-key

# ── Storage ────────────────────────────────────────────────────────────
# Where uploaded PDFs and exported briefs live.
#   filesystem (default) — container disk, the original behaviour. A restart
#                          on ephemeral disk loses uploads, and two API
#                          instances cannot share them.
#   azure                — Azure Blob Storage. docker-compose.yml runs
#                          Azurite, so this path works locally with no cloud
#                          account and no credentials.
# References written before the switch keep resolving either way: anything
# without an azure:// scheme is read from disk regardless of the backend.
STORAGE_BACKEND=filesystem
# AZURE_STORAGE_CONTAINER=meridian-uploads
# Azurite's published development credential — identical on every machine,
# documented by Microsoft, and not a secret. A real deployment overrides it.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# Application
LOG_LEVEL=INFO
DEV_MODE=false
CHROMA_PERSIST_DIR=./data/chroma
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF=2.0

# Comma-separated browser origins allowed by CORS (frontend domains)
# CORS_ORIGINS=https://meridian.example.com,http://localhost:3000

# Parallel dimension-analysis workers (default 8). Each dimension is one
# combined evaluation+recommendations LLM call; with multiple Gemini keys the
# pool round-robins across keys (per-key RPM throttle), so higher is faster
# up to the key count x per-key RPM ceiling.
# ANALYSIS_MAX_CONCURRENCY=8

# Gemini free-tier throttle, PER KEY (each configured GEMINI_API_KEY_N gets
# its own window): flash-tier models allow ~10-15 requests/min per key.
# GEMINI_RPM_LIMIT=10

# Chat reply budget (tokens). Chat prompts cap replies at ~120 words, so the
# analysis path's 8192-token generation budget is overkill here and adds
# latency; a smaller cap makes chat replies complete faster.
# CHAT_MAX_OUTPUT_TOKENS=2048

# Deterministic coverage ladder (backend/src/deterministic.py)
# 1 = R1 floor active: Missing is raised to Partial only on an explicit
#     commitment/attempted mechanism (never a bare risk acknowledgment).
# 0 = R1 floor disabled: Missing stays Missing (R2 can only raise Partial to
#     Covered). Used for before/after comparisons of floor impact.
LADDER_FLOOR_ENABLED=1

[PRODUCTION]
# Required by docker-compose.prod.yml — it refuses to start without it, so a
# production database can never come up on the dev stack's aura/aura.
# POSTGRES_PASSWORD=generate-a-long-random-value
# POSTGRES_USER=aura
# POSTGRES_DB=aura_sdg
# Used by docker-compose.prod.yml — see LAUNCH.md
# Public API URL inlined into the frontend at build time:
# NEXT_PUBLIC_API_URL=https://meridian.example.com/api/v1
# Public domain for Caddy TLS:
# SITE_ADDRESS=meridian.example.com
